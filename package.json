{
  "name": "traco-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cd apps/web && npm run dev",
    "dev:api": "java -jar apps/backend/target/traco-api-0.1.0.jar",
    "build:api": "cd apps/backend && mvn -B -DskipTests package",
    "build": "cd apps/web && npm run build",
    "lint": "cd apps/web && npm run lint",
    "install:all": "npm install && cd apps/web && npm install"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}